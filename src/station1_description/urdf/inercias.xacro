<?xml version="1.0"?>
<!--
  Macros que derivan masa y tensor de inercia a partir de la geometria de la
  pieza y de la densidad del material asignado.

  El proposito es que masa e inercia no se escriban a mano: si cambia una
  dimension o el material de una pieza, sus propiedades inerciales cambian con
  ella y siguen siendo coherentes.

  Los tensores corresponden a solidos homogeneos respecto de su centro de masa.
  Cuando el modelo CAD este terminado, estos valores se contrastan con los que
  exporte el CAD, que es la fuente definitiva.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Prisma rectangular de dimensiones x, y, z y densidad dada. -->
  <xacro:macro name="inercia_caja" params="x y z densidad *origen">
    <inertial>
      <xacro:insert_block name="origen"/>
      <xacro:property name="m" value="${densidad * x * y * z}"/>
      <mass value="${m}"/>
      <inertia
        ixx="${m * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${m * (x*x + z*z) / 12.0}" iyz="0.0"
        izz="${m * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Cilindro solido de radio r y longitud h, con el eje en Z. -->
  <xacro:macro name="inercia_cilindro" params="radio longitud densidad *origen">
    <inertial>
      <xacro:insert_block name="origen"/>
      <xacro:property name="m" value="${densidad * pi * radio * radio * longitud}"/>
      <mass value="${m}"/>
      <inertia
        ixx="${m * (3.0*radio*radio + longitud*longitud) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${m * (3.0*radio*radio + longitud*longitud) / 12.0}" iyz="0.0"
        izz="${m * radio * radio / 2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Masa concentrada, para componentes comerciales cuya masa se conoce por
       hoja de datos pero cuya geometria interna no se modela. Se aproxima como
       un prisma homogeneo de las dimensiones exteriores del componente. -->
  <xacro:macro name="inercia_componente" params="masa x y z *origen">
    <inertial>
      <xacro:insert_block name="origen"/>
      <mass value="${masa}"/>
      <inertia
        ixx="${masa * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${masa * (x*x + z*z) / 12.0}" iyz="0.0"
        izz="${masa * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

</robot>
