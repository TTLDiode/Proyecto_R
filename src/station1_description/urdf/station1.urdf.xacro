<?xml version="1.0"?>
<!--
  Estacion 1 - Alimentacion y singulacion
  Configuracion RRP, tipo SCARA: theta1 en la base, theta2 en el codo y d3
  como desplazamiento vertical.

  Responsable: Santiago Fernando Machado Sanchez

  Transmision:
    theta1  motor alojado dentro de la columna, accionamiento directo
    theta2  motor sobre el eslabon 1 y coaxial con theta1, correa de 400 mm
    d3      motor sobre el eslabon 2 a 94 mm del codo, correa de 140 mm

  Revision del 15 de agosto de 2026: geometria y propiedades inerciales
  tomadas del CAD. Los eslabones dejaron de ser pletinas: el 1 es una
  estructura hueca de dos placas que aloja la polea de su correa, y el 2
  carga el eje vertical completo con su puente. Las masas e inercias se
  calculan sumando las 38 piezas del ensamble y llegan aqui como constantes,
  no como formulas: ver la cabecera de parametros.xacro.

  Todos los frames llevan el prefijo de la estacion, segun ADR-005.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="station1">

  <xacro:arg name="prefijo" default="station1/"/>
  <xacro:property name="p" value="$(arg prefijo)"/>

  <xacro:include filename="$(find station1_description)/urdf/parametros.xacro"/>
  <xacro:include filename="$(find station1_description)/urdf/inercias.xacro"/>
  <xacro:include filename="$(find station1_description)/urdf/station1.gazebo.xacro"/>
  <xacro:include filename="$(find station1_description)/urdf/station1.ros2_control.xacro"/>

  <!-- Con control:=false el modelo se puede abrir en RViz sin levantar el
       controller_manager, que es como se reviso el arbol TF en la Entrega 1. -->
  <xacro:arg name="control" default="true"/>
  <xacro:arg name="controladores"
             default="$(find station1_description)/config/station1_controllers.yaml"/>

  <material name="acrilico">  <color rgba="0.35 0.55 0.75 0.75"/></material>
  <material name="mdf">       <color rgba="0.72 0.58 0.38 1.0"/></material>
  <material name="pla">       <color rgba="0.90 0.90 0.90 1.0"/></material>
  <material name="metal">     <color rgba="0.55 0.55 0.58 1.0"/></material>
  <material name="motor">     <color rgba="0.20 0.20 0.22 1.0"/></material>

  <!-- ==================================================================
       base_link: placa de MDF, columna hueca con el motor de theta1 dentro,
       brida y rodamiento de theta1, mas el pilar del final de carrera y la
       electronica. Es un eslabon fijo al mundo, de modo que su inercia no
       interviene en la dinamica; se declara la masa real para que el balance
       de la estacion sea correcto.

       Apilado:  0 a 12 placa,  12 a 160 columna,  160 a 166 brida,
                 166 a 173 rodamiento 6804.
  =================================================================== -->
  <xacro:property name="z_columna_alto" value="${0.160 - base_z}"/>
  <!-- Placa de 260 mm 0.568, columna en tubo 0.129, brida 0.046, rodamiento
       0.027, motor 0.210, pilar del final de carrera 0.251, electronica
       0.020. El pilar pesa lo que pesa y esta 88 mm por detras del eje, de
       modo que desplaza el centro de la base a -16.4 mm y ayuda al balance. -->
  <xacro:property name="m_base" value="1.266"/>

  <link name="${p}base_link">
    <visual>
      <origin xyz="0 0 ${base_z/2}"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
      <material name="mdf"/>
    </visual>
    <visual>
      <origin xyz="0 0 ${base_z + z_columna_alto/2}"/>
      <geometry><cylinder radius="${columna_radio}" length="${z_columna_alto}"/></geometry>
      <material name="pla"/>
    </visual>
    <visual>
      <origin xyz="0 0 ${0.160 + brida_espesor/2}"/>
      <geometry><cylinder radius="${columna_radio}" length="${brida_espesor}"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 0 ${altura_columna - rod_art_alto/2}"/>
      <geometry><cylinder radius="${rod_art_diam/2}" length="${rod_art_alto}"/></geometry>
      <material name="metal"/>
    </visual>
    <!-- Motor de theta1, dentro de la columna. El cuerpo va desplazado 7 mm
         del eje de salida porque la reductora saca el eje a un lado. -->
    <visual>
      <origin xyz="${motor_desfase} 0 ${0.160 - motor_cuerpo/2}"/>
      <geometry><cylinder radius="${motor_diametro/2}" length="${motor_cuerpo}"/></geometry>
      <material name="motor"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${base_z/2}"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${base_z + (altura_columna - base_z)/2}"/>
      <geometry><cylinder radius="${columna_radio}" length="${altura_columna - base_z}"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${altura_columna/3}"/>
      <mass value="${m_base}"/>
      <inertia
        ixx="${m_base * (base_y*base_y + altura_columna*altura_columna) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${m_base * (base_x*base_x + altura_columna*altura_columna) / 12.0}" iyz="0.0"
        izz="${m_base * (base_x*base_x + base_y*base_y) / 12.0}"/>
    </inertial>
  </link>

  <!-- ==================================================================
       Anclaje al mundo.

       La estacion va atornillada a la mesa, y eso es lo que modela esta
       union fija al mundo.

       Con la placa de 220 mm original no se sostenia sola: el centro de masa
       caia a 114.0 mm con el brazo extendido y el borde estaba a 110. La
       placa paso a 260 mm y ahora el centro queda a 107.5 con el borde a
       130, de modo que aguanta de pie aunque se le quiten los tornillos.

       Con anclar:=false se puede comprobar precisamente eso.
  =================================================================== -->
  <xacro:arg name="anclar" default="true"/>
  <xacro:if value="$(arg anclar)">
    <link name="world"/>
    <joint name="${p}anclaje" type="fixed">
      <parent link="world"/>
      <child  link="${p}base_link"/>
    </joint>
  </xacro:if>

  <!-- ==================== theta1: rotacion de la base ====================
       El origen esta en la cara inferior del eslabon 1, que es donde apoya el
       rodamiento. El final de carrera dispara a 180 grados, con el brazo
       apuntando al lado opuesto de la linea.
  -->
  <joint name="${p}joint_1" type="revolute">
    <parent link="${p}base_link"/>
    <child  link="${p}link_1"/>
    <origin xyz="0 0 ${altura_columna}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${lim_theta1_inf}" upper="${lim_theta1_sup}"
           velocity="${vel_rot}" effort="${esfuerzo_rot}"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- ==================================================================
       link_1: estructura hueca de dos placas de acrilico de 8 mm separadas
       18 por cuatro separadores de aluminio. La polea de la correa de theta2
       va alojada en ese hueco, que es lo que obliga a la estructura. Encima
       lleva el motor de theta2, coaxial con theta1: al estar sobre el eje de
       giro su masa no penaliza la inercia del eslabon.
  =================================================================== -->
  <link name="${p}link_1">
    <visual>
      <origin xyz="${(l1+cola)/2 - cola} 0 ${brazo_espesor/2}"/>
      <geometry><box size="${l1+cola} ${brazo_ancho} ${brazo_espesor}"/></geometry>
      <material name="acrilico"/>
    </visual>
    <visual>
      <origin xyz="${(l1+cola)/2 - cola} 0 ${link1_alto - brazo_espesor/2}"/>
      <geometry><box size="${l1+cola} ${brazo_ancho} ${brazo_espesor}"/></geometry>
      <material name="acrilico"/>
    </visual>
    <xacro:macro name="separador_l1" params="sx sy">
      <visual>
        <origin xyz="${sx} ${sy} ${link1_alto/2}"/>
        <geometry><cylinder radius="0.005" length="${link1_alto - 2*brazo_espesor}"/></geometry>
        <material name="metal"/>
      </visual>
    </xacro:macro>
    <xacro:separador_l1 sx="0.045" sy="0.018"/>
    <xacro:separador_l1 sx="0.045" sy="-0.018"/>
    <xacro:separador_l1 sx="0.150" sy="0.018"/>
    <xacro:separador_l1 sx="0.150" sy="-0.018"/>
    <visual>
      <origin xyz="${motor_desfase} 0 ${link1_alto + motor_cuerpo/2}"/>
      <geometry><cylinder radius="${motor_diametro/2}" length="${motor_cuerpo}"/></geometry>
      <material name="motor"/>
    </visual>

    <!-- Colision: la envolvente de la estructura hueca mas el motor. -->
    <collision>
      <origin xyz="${(l1+cola)/2 - cola} 0 ${link1_alto/2}"/>
      <geometry><box size="${l1+cola} ${brazo_ancho} ${link1_alto}"/></geometry>
    </collision>
    <collision>
      <origin xyz="${motor_desfase} 0 ${link1_alto + motor_cuerpo/2}"/>
      <geometry><cylinder radius="${motor_diametro/2}" length="${motor_cuerpo}"/></geometry>
    </collision>

    <inertial>
      <origin xyz="${cx_link1} ${cy_link1} ${cz_link1}"/>
      <mass value="${m_link1}"/>
      <inertia ixx="${ixx_link1}" ixy="${ixy_link1}" ixz="${ixz_link1}"
               iyy="${iyy_link1}" iyz="${iyz_link1}" izz="${izz_link1}"/>
    </inertial>
  </link>

  <!-- ==================== theta2: codo ====================
       El eje del codo sube desde el eslabon 2, atraviesa el eslabon 1 y
       sobresale por su cara superior, donde lleva la leva del final de
       carrera. El origen de la articulacion esta en el plano de contacto
       entre ambos eslabones.
  -->
  <joint name="${p}joint_2" type="revolute">
    <parent link="${p}link_1"/>
    <child  link="${p}link_2"/>
    <origin xyz="${l1} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-lim_theta2}" upper="${lim_theta2}"
           velocity="${vel_rot}" effort="${esfuerzo_rot}"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- ==================================================================
       link_2: placa de acrilico de 12 mm que cuelga por debajo del eslabon 1
       y carga el eje vertical completo. Es el unico eslabon que lleva un
       motor en voladizo, y por eso su espesor subio de 8 a 12 mm.
  =================================================================== -->
  <link name="${p}link_2">
    <visual>
      <origin xyz="${(l2+cola)/2 - cola} 0 ${-link2_espesor/2}"/>
      <geometry><box size="${l2+cola} ${brazo_ancho} ${link2_espesor}"/></geometry>
      <material name="acrilico"/>
    </visual>
    <!-- Husillo y varilla de guia antigiro, paralelos -->
    <visual>
      <origin xyz="${l2} ${y_husillo} ${husillo_largo/2}"/>
      <geometry><cylinder radius="${husillo_radio}" length="${husillo_largo}"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="${l2} ${y_guia} ${husillo_largo/2}"/>
      <geometry><cylinder radius="${husillo_radio}" length="${husillo_largo}"/></geometry>
      <material name="metal"/>
    </visual>
    <!-- Puente que sostiene el rodamiento superior del husillo -->
    <visual>
      <origin xyz="0.121 0.020 0.063"/>
      <geometry><box size="0.010 0.024 0.126"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0.135 0 0.130"/>
      <geometry><box size="0.038 0.068 0.008"/></geometry>
      <material name="metal"/>
    </visual>
    <!-- Soporte y motor de d3 -->
    <visual>
      <origin xyz="${motor3_offset - motor_desfase} 0 0.032"/>
      <geometry><box size="0.047 0.047 0.006"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="${motor3_offset - motor_desfase} 0 ${0.035 + motor_cuerpo/2}"/>
      <geometry><cylinder radius="${motor_diametro/2}" length="${motor_cuerpo}"/></geometry>
      <material name="motor"/>
    </visual>

    <collision>
      <origin xyz="${(l2+cola)/2 - cola} 0 ${-link2_espesor/2}"/>
      <geometry><box size="${l2+cola} ${brazo_ancho} ${link2_espesor}"/></geometry>
    </collision>
    <collision>
      <origin xyz="${l2} 0 ${husillo_largo/2}"/>
      <geometry><box size="0.038 0.068 ${husillo_largo}"/></geometry>
    </collision>
    <collision>
      <origin xyz="${motor3_offset - motor_desfase} 0 ${0.035 + motor_cuerpo/2}"/>
      <geometry><cylinder radius="${motor_diametro/2}" length="${motor_cuerpo}"/></geometry>
    </collision>

    <inertial>
      <origin xyz="${cx_link2} ${cy_link2} ${cz_link2}"/>
      <mass value="${m_link2}"/>
      <inertia ixx="${ixx_link2}" ixy="${ixy_link2}" ixz="${ixz_link2}"
               iyy="${iyy_link2}" iyz="${iyz_link2}" izz="${izz_link2}"/>
    </inertial>
  </link>

  <!-- ==================== d3: desplazamiento vertical ====================
       El origen esta en la cara inferior del carro con d3 = 0, es decir en
       lo alto del recorrido, y el desplazamiento es descendente. El tope
       inferior lo impone la tuerca al llegar a la polea del husillo, y en la
       maquina lo materializa el brazo de la leva contra el eslabon 2.
  -->
  <joint name="${p}joint_3" type="prismatic">
    <parent link="${p}link_2"/>
    <child  link="${p}link_3"/>
    <origin xyz="${l2} 0 ${carro_z0}"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="${carrera_d3}"
           velocity="${vel_pris}" effort="${esfuerzo_pris}"/>
    <!-- La friccion no es un numero de relleno: es lo que hace del eje un eje
         autoblocante. El husillo trabaja con un rendimiento directo de 0.2, y
         un husillo por debajo de 0.5 no se puede retroaccionar: el carro no
         baja solo aunque se corte la corriente. Con 0.5 N, por debajo de los
         2.17 N que pesa el conjunto, se describia justo lo contrario, un eje
         que se descuelga. Con 4.0 N, por encima del peso, el eje se sostiene
         solo y al actuador le quedan 61 N para moverlo.

         Aviso para no atribuirle lo que no hace: este cambio NO es lo que
         arreglo el error de seguimiento de la prismatica al descender. Ese
         error resulto depender de la velocidad pedida, no de la gravedad, y se
         corrigio planificando al 70 % del limite de velocidad; la medida esta
         en station1_control/trayectoria.py. La gravedad si explica que
         bajando el error sea unas diez veces mayor que subiendo a igualdad de
         velocidad, pero no el fenomeno principal. -->
    <dynamics damping="2.0" friction="4.0"/>
  </joint>

  <!-- ==================================================================
       link_3: carro de aluminio, tuerca de laton, casquillo de la guia,
       vastago y el brazo de la leva del final de carrera de d3.
  =================================================================== -->
  <link name="${p}link_3">
    <visual>
      <origin xyz="0 0 ${carro_espesor/2}"/>
      <geometry><box size="0.028 0.060 ${carro_espesor}"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 ${y_husillo} ${carro_espesor + tuerca_lado/2}"/>
      <geometry><box size="${tuerca_lado} ${tuerca_lado} ${tuerca_lado}"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 ${y_guia} ${carro_espesor + 0.006}"/>
      <geometry><cylinder radius="0.006" length="0.012"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 0 ${-vastago_largo/2}"/>
      <geometry><cylinder radius="${vastago_radio}" length="${vastago_largo}"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="-0.018 -0.014 ${-vastago_largo + 0.003}"/>
      <geometry><box size="0.064 0.048 0.006"/></geometry>
      <material name="metal"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${carro_espesor/2}"/>
      <geometry><box size="0.028 0.060 ${carro_espesor}"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${-vastago_largo/2}"/>
      <geometry><cylinder radius="${vastago_radio}" length="${vastago_largo}"/></geometry>
    </collision>

    <inertial>
      <origin xyz="${cx_link3} ${cy_link3} ${cz_link3}"/>
      <mass value="${m_link3}"/>
      <inertia ixx="${ixx_link3}" ixy="${ixy_link3}" ixz="${ixz_link3}"
               iyy="${iyy_link3}" iyz="${iyz_link3}" izz="${izz_link3}"/>
    </inertial>
  </link>

  <!-- ==================== Efector final ====================
       Micro servo Tower Pro 9 g con mordaza impresa. No cuenta como grado de
       libertad: los tres GDL son los tres motores DC.
  -->
  <xacro:property name="m_mordaza" value="${densidad_pla * gripper_x * gripper_y * gripper_z * 0.35}"/>
  <xacro:property name="m_gripper" value="${masa_servo + m_mordaza}"/>

  <joint name="${p}gripper_joint" type="revolute">
    <parent link="${p}link_3"/>
    <child  link="${p}gripper_link"/>
    <origin xyz="0 0 ${-vastago_largo}"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="${lim_gripper}" velocity="3.0" effort="0.15"/>
  </joint>

  <link name="${p}gripper_link">
    <visual>
      <origin xyz="0 0 ${-servo_z/2}"/>
      <geometry><box size="${servo_x} ${servo_y} ${servo_z}"/></geometry>
      <material name="motor"/>
    </visual>
    <visual>
      <origin xyz="0 0 ${-gripper_z/2}"/>
      <geometry><box size="${gripper_x} ${gripper_y} ${gripper_z}"/></geometry>
      <material name="pla"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-gripper_z/2}"/>
      <geometry><box size="${gripper_x} ${gripper_y} ${gripper_z}"/></geometry>
    </collision>
    <xacro:inercia_componente masa="${m_gripper}"
                              x="${gripper_x}" y="${gripper_y}" z="${gripper_z}">
      <origin xyz="0 0 ${-gripper_z/2}"/>
    </xacro:inercia_componente>
  </link>

  <!-- Punto de referencia del efector, donde se sujeta la pieza.
       Cuelga del carro y no de la mordaza: tool0 es un sistema fijo del
       brazo, y si girase con el servo el punto de trabajo se desplazaria
       16.8 mm al abrir la pinza y el grupo de planificacion pasaria a tener
       cuatro articulaciones en lugar de los tres grados de libertad que pide
       la guia. Con la mordaza cerrada la pose es identica a la de la
       Entrega 1. -->
  <joint name="${p}tool0_joint" type="fixed">
    <parent link="${p}link_3"/>
    <child  link="${p}tool0"/>
    <origin xyz="0 0 ${-(vastago_largo + gripper_z)}"/>
  </joint>
  <link name="${p}tool0"/>

  <xacro:station1_gazebo prefijo="${p}"/>

  <!-- ==================================================================
       Acople cinematico de la pieza, segun ADR-002.

       No acopla al arrancar. El nodo de la estacion pide el acople cuando
       cierra la mordaza sobre la pieza y lo deshace antes de abrirla.
  =================================================================== -->
  <xacro:arg name="acople" default="true"/>
  <xacro:arg name="pieza" default="pieza"/>
  <xacro:if value="$(arg acople)">
    <gazebo>
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>${p}gripper_link</parent_link>
        <child_model>$(arg pieza)</child_model>
        <child_link>cuerpo</child_link>
        <attach_topic>/station1/pieza/attach</attach_topic>
        <detach_topic>/station1/pieza/detach</detach_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </gazebo>
  </xacro:if>

  <xacro:if value="$(arg control)">
    <xacro:station1_ros2_control prefijo="${p}"
                                 controladores="$(arg controladores)"/>
  </xacro:if>

</robot>
